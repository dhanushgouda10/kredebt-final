¸# Kredent backend — environment variable template.
#
# Copy this file to `backend/.env` (already gitignored) and fill in the values, then start the
# backend from the backend/ directory. Real environment variables (IDE run config, shell, Azure app
# settings) override anything in the file. NEVER commit a filled-in .env.
#
# This example intentionally contains no real secret.

# ---- Database (existing PostgreSQL / Supabase) --------------------------------------------
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# ---- Auth ---------------------------------------------------------------------------------
JWT_SECRET=
WALLET_ENCRYPTION_SECRET=
# Optional: secret mixed into stored OTP hashes. Falls back to JWT_SECRET when empty.
OTP_HMAC_SECRET=

# ---- Gmail SMTP (OTP emails) --------------------------------------------------------------
# Sends through smtp.gmail.com:587 with STARTTLS using Spring Boot JavaMailSender.
# MAIL_PASSWORD must be a Gmail *App Password* (Google Account > Security > 2-Step Verification >
# App passwords) — not your normal Gmail password. Fill it in locally; it is never sent to the
# frontend and never logged. Leave it empty and the OTP endpoints answer 503 instead of pretending.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=aicteportalverify@gmail.com
MAIL_PASSWORD=
MAIL_FROM=aicteportalverify@gmail.com

# ---- Simulated institutional registry (DEMO ONLY — not an official AICTE service) ----------
# SQLite file, kept separate from PostgreSQL (created automatically on first start).
REGISTRY_DB_PATH=./data/registry.db
# Registry administrator sign-in. If REGISTRY_ADMIN_PASSWORD is empty, a random password is
# generated once on first start and printed to the backend console.
REGISTRY_ADMIN_EMAIL=registry.admin@kredent.local
REGISTRY_ADMIN_PASSWORD=
# Optional: your own mailbox, so OTPs for the seeded sample colleges reach you while testing.
# Each college gets a plus-address of it (you+demo1001@gmail.com) — Gmail delivers all to you.
REGISTRY_DEMO_HOI_EMAIL=
REGISTRY_SEED_SAMPLE_DATA=true

# ---- Existing settings (unchanged) --------------------------------------------------------
ADMIN_WALLET_ADDRESS=
FRONTEND_BASE_URL=http://localhost:5173
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
BLOCKCHAIN_RPC_URL=

# One-off: registry institutional ID that owns students/certificates created before multi-institution
# support. On start-up, rows with no institution are attached to it once it has completed verification.
INSTITUTION_ADOPT_LEGACY_DATA_FOR=
